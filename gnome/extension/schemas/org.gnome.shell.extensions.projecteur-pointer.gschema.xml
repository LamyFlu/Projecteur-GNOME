<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.projecteur-pointer" path="/org/gnome/shell/extensions/projecteur-pointer/">
    <key name="timer-minutes" type="i"><range min="1" max="1440"/><default>15</default><summary>Presentation timer duration in minutes</summary></key>
    <key name="timer-vibration" type="b"><default>false</default><summary>Vibrate compatible presenters when the presentation timer expires</summary></key>
    <key name="vibration-intensity" type="i"><range min="1" max="255"/><default>128</default><summary>Timer feedback intensity</summary></key>
    <key name="vibration-length" type="i"><range min="1" max="10"/><default>1</default><summary>Original Spotlight vibration duration units</summary></key>
    <key name="effect-presets" type="s"><default>'[]'</default><summary>Named effect appearance presets</summary></key>
    <key name="spotlight-shape" type="s"><choices><choice value="circle"/><choice value="square"/><choice value="diamond"/></choices><default>'circle'</default><summary>Spotlight cutout shape</summary></key>
    <key name="spotlight-rotation" type="i"><range min="0" max="359"/><default>0</default><summary>Spotlight shape rotation in degrees</summary></key>
    <key name="spotlight-color" type="s"><default>'rgb(0,0,0)'</default><summary>Spotlight shade color</summary></key>
    <key name="spotlight-border-color" type="s"><default>'rgb(255,255,255)'</default><summary>Spotlight border color</summary></key>
    <key name="spotlight-border-width" type="i"><range min="0" max="12"/><default>0</default><summary>Spotlight border width</summary></key>
    <key name="magnifier-quality" type="s"><choices><choice value="smooth"/><choice value="text"/><choice value="pixel"/></choices><default>'smooth'</default><summary>Magnifier sampling quality</summary></key>
    <key name="trail-enabled" type="b"><default>false</default><summary>Enable fading pointer trail</summary></key>
    <key name="trail-seconds" type="d"><range min="0.1" max="2.0"/><default>0.5</default><summary>Pointer trail lifetime in seconds</summary></key>
    <key name="button-mappings" type="s"><default>'{}'</default><summary>Optional presenter button actions</summary></key>
    <key name="last-applied-preset" type="s"><default>''</default><summary>Name of the last explicitly applied preset</summary></key>
    <key name="dot-color" type="s">
      <default>'rgb(255,24,24)'</default>
      <summary>Laser dot color</summary>
    </key>
    <key name="dot-size" type="i">
      <range min="6" max="96"/>
      <default>18</default>
      <summary>Laser dot diameter in logical pixels</summary>
    </key>
    <key name="hide-system-cursor" type="b">
      <default>true</default>
      <summary>Hide the system cursor while the laser dot is visible</summary>
    </key>
    <key name="always-visible" type="b">
      <default>false</default>
      <summary>Keep the selected effect visible without an idle timeout</summary>
    </key>
    <key name="linger-seconds" type="d">
      <range min="0.1" max="30.0"/>
      <default>3.0</default>
      <summary>Seconds to keep the laser dot after the last presenter motion</summary>
    </key>
    <key name="start-at-monitor-center" type="b">
      <default>false</default>
      <summary>Start each activation at the center of the remembered monitor</summary>
    </key>
    <key name="last-monitor-connector" type="s">
      <default>''</default>
      <summary>Connector identity of the monitor last used by the pointer effect</summary>
    </key>
    <key name="pointer-mode" type="s">
      <choices><choice value="laser"/><choice value="spotlight"/><choice value="magnifier"/></choices>
      <default>'laser'</default>
      <summary>Selected presenter effect</summary>
    </key>
    <key name="spotlight-enabled" type="b">
      <default>false</default><summary>Include spotlight in the available modes</summary>
    </key>
    <key name="magnifier-enabled" type="b">
      <default>false</default><summary>Include magnifier in the available modes</summary>
    </key>
    <key name="double-click-switch" type="b">
      <default>false</default><summary>Switch effects on a presenter pointer double click</summary>
    </key>
    <key name="spotlight-size" type="i">
      <range min="80" max="1200"/><default>300</default>
      <summary>Spotlight diameter in logical pixels</summary>
    </key>
    <key name="spotlight-dim" type="d">
      <range min="0.1" max="0.9"/><default>0.65</default>
      <summary>Darkening opacity outside the spotlight</summary>
    </key>
    <key name="magnifier-size" type="i">
      <range min="80" max="1200"/><default>300</default>
      <summary>Magnifier diameter in logical pixels</summary>
    </key>
    <key name="magnifier-factor" type="d">
      <range min="1.1" max="8.0"/><default>2.0</default>
      <summary>Magnification factor</summary>
    </key>
    <key name="pointer-clicks-enabled" type="b">
      <default>false</default><summary>Forward presenter left mouse clicks to applications</summary>
    </key>
    <key name="laser-enabled" type="b">
      <default>true</default><summary>Include the laser dot in the available modes</summary>
    </key>
  </schema>
</schemalist>
